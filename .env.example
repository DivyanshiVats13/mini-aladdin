# ──────────────────────────────────────
# Mini Aladdin — Environment Variables
# ──────────────────────────────────────
# Copy this file to .env and fill in the values.

# PostgreSQL
POSTGRES_DB=mini_aladdin_db
POSTGRES_USER=aladdin
POSTGRES_PASSWORD=aladdin_secret
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# Kafka
KAFKA_PORT=9092

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_BASE64_STRING
JWT_EXPIRATION_MS=86400000

# Market Data APIs
ALPHA_VANTAGE_API_KEY=
YAHOO_FINANCE_API_KEY=
TRUEDATA_API_KEY=

# Stripe (future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
